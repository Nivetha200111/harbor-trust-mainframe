         PRINT NOGEN
HTCDMAP   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,
               TIOAPFX=YES,TERM=3270,CTRL=(FREEKB,FRSET)
HTC1    DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=27,ATTRB=(PROT,NORM),INITIAL='CARD BLOCK'
         DFHMDF POS=(1,70),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='HTCDMAP'
TITLE    DFHMDF POS=(2,2),LENGTH=40,ATTRB=(PROT,BRT),INITIAL='HARBOR TRUST - CARD BLOCK'
ACCTLBL  DFHMDF POS=(5,2),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='ACCOUNT:'
ACCT     DFHMDF POS=(5,18),LENGTH=12,ATTRB=(UNPROT,IC,FSET)
TOACLBL  DFHMDF POS=(7,2),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='TO ACCT:'
TOACCT   DFHMDF POS=(7,18),LENGTH=12,ATTRB=(UNPROT,FSET)
AMTLBL   DFHMDF POS=(9,2),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='AMOUNT:'
AMOUNT   DFHMDF POS=(9,18),LENGTH=12,ATTRB=(UNPROT,FSET)
CARDLBL  DFHMDF POS=(11,2),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='CARD:'
CARD     DFHMDF POS=(11,18),LENGTH=16,ATTRB=(UNPROT,FSET)
PINLBL   DFHMDF POS=(13,2),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='PIN:'
PIN      DFHMDF POS=(13,18),LENGTH=8,ATTRB=(UNPROT,DRK,FSET)
SRCHLBL  DFHMDF POS=(15,2),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='SEARCH:'
SRCH     DFHMDF POS=(15,18),LENGTH=20,ATTRB=(UNPROT,FSET)
BALLBL   DFHMDF POS=(17,2),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='BALANCE:'
BAL      DFHMDF POS=(17,18),LENGTH=14,ATTRB=(PROT,NORM)
STSLBL   DFHMDF POS=(17,40),LENGTH=8,ATTRB=(PROT,NORM),INITIAL='STATUS:'
STS      DFHMDF POS=(17,54),LENGTH=8,ATTRB=(PROT,NORM)
MSGLBL   DFHMDF POS=(20,2),LENGTH=5,ATTRB=(PROT,NORM),INITIAL='MSG:'
MSG      DFHMDF POS=(20,10),LENGTH=60,ATTRB=(PROT,NORM)
HELP     DFHMDF POS=(23,2),LENGTH=45,ATTRB=(PROT,NORM),INITIAL='ENTER=GO PF3=EXIT PF5=ACTION PF6=SCROLL'
         DFHMSD TYPE=FINAL
         END
