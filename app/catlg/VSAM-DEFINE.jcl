//HTVSAM   JOB (HT),'DEFINE FICTIONAL VSAM',CLASS=A,MSGCLASS=X
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(HT.ACCT.KSDS) -
   INDEXED KEYS(12 0) RECORDSIZE(160 160) -
   FREESPACE(10 5) SHAREOPTIONS(2 3) -
   VOLUMES(SYN001) TRACKS(50 10)) -
   DATA (NAME(HT.ACCT.KSDS.DATA)) -
   INDEX (NAME(HT.ACCT.KSDS.INDEX))
 DEFINE ALTERNATEINDEX (NAME(HT.ACCT.AIX.CUST) -
   RELATE(HT.ACCT.KSDS) KEYS(20 12) NONUNIQUE UPGRADE)
 DEFINE PATH (NAME(HT.ACCT.PATH.CUST) -
   PATHENTRY(HT.ACCT.AIX.CUST))
/*
