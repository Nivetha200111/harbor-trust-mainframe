>>SOURCE FORMAT FREE
       IDENTIFICATION DIVISION.
       PROGRAM-ID. HTCIN.
      *> CICS transaction program: Card inquiry. Synthetic training estate.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-COMMAREA.
          05 WS-ACCOUNT PIC X(12).
          05 WS-SECOND-ACCOUNT PIC X(12).
          05 WS-AMOUNT PIC S9(9)V99 COMP-3.
          05 WS-BALANCE PIC S9(9)V99 COMP-3.
          05 WS-STATUS PIC X(8).
          05 WS-MESSAGE PIC X(60).
          05 WS-RESP PIC S9(8) COMP.
          05 WS-REAS PIC S9(8) COMP.
          05 WS-AID PIC X.
          05 WS-EOF PIC X VALUE "N".
       COPY DFHAID.
       COPY DFHBMSCA.
       01 HTCINI.
          05 FILLER PIC X(12).
          05 ACCTIL PIC S9(4) COMP.
          05 ACCTIF PIC X.
          05 ACCTI PIC X(12).
          05 MSGIL PIC S9(4) COMP.
          05 MSGIF PIC X.
          05 MSGI PIC X(60).
       01 HTCINO.
          05 FILLER PIC X(12).
          05 ACCTOL PIC S9(4) COMP.
          05 ACCTOF PIC X.
          05 ACCTO PIC X(12).
          05 MSGOL PIC S9(4) COMP.
          05 MSGOF PIC X.
          05 MSGO PIC X(60).
       LINKAGE SECTION.
       01 DFHCOMMAREA PIC X(128).
       PROCEDURE DIVISION.
       0000-ENTRY.
           PERFORM 7870-CHECK-COMMAREA-RETURN-LENGTH
           PERFORM 7860-CHECK-TASK-RESPONSE
           PERFORM 7850-CHECK-BMS-INPUT-MAP
           PERFORM 7840-CHECK-RETURN-CONTEXT
           PERFORM 7830-CHECK-PROTECTED-STATUS
           PERFORM 7820-CHECK-RESPONSE-CODE
           PERFORM 7810-CHECK-USER-INPUT
           PERFORM 7800-CHECK-TERM-TRANSACTION
           PERFORM 7700-TRANSACTION-RESPONSE-CHECKS
           PERFORM 7000-TRANSACTION-VALIDATIONS
           IF EIBCALEN > ZERO
               MOVE DFHCOMMAREA TO WS-COMMAREA
           END-IF
           EVALUATE TRUE
             WHEN EIBCALEN = ZERO PERFORM 1000-SEND-MAP
             WHEN OTHER PERFORM 2000-RECEIVE-MAP
           END-EVALUATE
           EXEC CICS RETURN TRANSID('HTCIN')
             COMMAREA(WS-COMMAREA) LENGTH(128) END-EXEC.
       1000-SEND-MAP.
           MOVE LOW-VALUES TO HTCINO
           MOVE DFHCOMMAREA TO WS-COMMAREA
           MOVE WS-ACCOUNT TO ACCTO
           MOVE WS-MESSAGE TO MSGO
           EXEC CICS SEND MAP('HTCIN') MAPSET('HTMAPS')
             FROM(HTCINO) ERASE RESP(WS-RESP) END-EXEC
           IF WS-RESP NOT = DFHRESP(NORMAL)
               MOVE "SEND MAP FAILED" TO WS-MESSAGE
           END-IF.
       2000-RECEIVE-MAP.
           EXEC CICS RECEIVE MAP('HTCIN') MAPSET('HTMAPS')
             INTO(HTCINI) RESP(WS-RESP) END-EXEC
           IF WS-RESP = DFHRESP(MAPFAIL)
               MOVE "NO INPUT RECEIVED" TO WS-MESSAGE
               EXIT PARAGRAPH
           END-IF
           IF WS-RESP NOT = DFHRESP(NORMAL)
               MOVE "RECEIVE MAP FAILED" TO WS-MESSAGE
               EXIT PARAGRAPH
           END-IF
           MOVE EIBAID TO WS-AID
           EVALUATE WS-AID
             WHEN DFHPF3 PERFORM 9000-EXIT-TRANSACTION
             WHEN DFHENTER PERFORM 3000-READ-ACCOUNT
             WHEN DFHPF5 PERFORM 4000-EXECUTE-ACTION
             WHEN OTHER MOVE "USE ENTER OR PF3" TO WS-MESSAGE
           END-EVALUATE.
       3000-READ-ACCOUNT.
           MOVE ACCTI TO WS-ACCOUNT
           EXEC CICS READ FILE('HTACCT')
             INTO(WS-COMMAREA) RIDFLD(WS-ACCOUNT)
             UPDATE RESP(WS-RESP) RESP2(WS-REAS) END-EXEC
           EVALUATE WS-RESP
             WHEN DFHRESP(NORMAL)
               MOVE "ACCOUNT FOUND" TO WS-MESSAGE
             WHEN DFHRESP(NOTFND)
               MOVE "ACCOUNT NOT FOUND" TO WS-MESSAGE
             WHEN OTHER
               MOVE "READ FAILED" TO WS-MESSAGE
               EXEC CICS ABEND ABCODE('HTR1') END-EXEC
           END-EVALUATE.
       4000-EXECUTE-ACTION.
           EXEC CICS LINK PROGRAM('HTPOST')
             COMMAREA(WS-COMMAREA) LENGTH(128)
             RESP(WS-RESP) RESP2(WS-REAS) END-EXEC
           IF WS-RESP = DFHRESP(NORMAL)
               MOVE "ACTION COMPLETE" TO WS-MESSAGE
           ELSE
               MOVE "ACTION LINK FAILED" TO WS-MESSAGE
           END-IF.
       5000-PERSIST-ACCOUNT.
           EXEC CICS WRITE FILE('HTACCT')
             FROM(WS-COMMAREA) RIDFLD(WS-ACCOUNT)
             RESP(WS-RESP) RESP2(WS-REAS) END-EXEC
           IF WS-RESP NOT = DFHRESP(NORMAL)
               MOVE "WRITE FAILED" TO WS-MESSAGE
           END-IF.
       6000-ROUTE-TO-DETAIL.
           EXEC CICS XCTL PROGRAM('HTAHI')
             COMMAREA(WS-COMMAREA) LENGTH(128) END-EXEC.
       9000-EXIT-TRANSACTION.
           EXEC CICS RETURN END-EXEC.

       7000-TRANSACTION-VALIDATIONS.
           PERFORM 7100-VALIDATE-ACCOUNT-KEY
           PERFORM 7110-VALIDATE-ACCOUNT-PREFIX
           PERFORM 7120-VALIDATE-ACCOUNT-STATUS
           PERFORM 7130-VALIDATE-BALANCE-SIGN
           PERFORM 7140-VALIDATE-TRANSFER-AMOUNT
           PERFORM 7150-VALIDATE-TRANSFER-CAP
           PERFORM 7160-VALIDATE-TRANSFER-PAIR
           PERFORM 7170-VALIDATE-REQUEST-AID
           PERFORM 7180-VALIDATE-RETURN-STATE
           PERFORM 7190-VALIDATE-RESP2-STATE
           PERFORM 7200-VALIDATE-COMMAREA-SIZE
           PERFORM 7210-VALIDATE-COMMAREA-CONTENT
           PERFORM 7220-VALIDATE-TRANSACTION-ID
           PERFORM 7230-VALIDATE-TERMINAL-ID
           PERFORM 7240-VALIDATE-MAP-CURSOR
           PERFORM 7250-VALIDATE-STATUS-FIELD
           PERFORM 7260-VALIDATE-DUPLICATE-REQUEST
           PERFORM 7270-VALIDATE-LOCK-RESPONSE
           PERFORM 7280-VALIDATE-MISSING-RECORD
           PERFORM 7290-VALIDATE-MAP-FAIL
           PERFORM 7300-VALIDATE-IO-RESPONSE
           PERFORM 7310-VALIDATE-WRITE-RESPONSE
           PERFORM 7320-VALIDATE-LINK-RESPONSE
           PERFORM 7330-VALIDATE-ROUTE-TARGET
           PERFORM 7340-VALIDATE-BLOCK-IDEMPOTENCE
           PERFORM 7350-VALIDATE-MESSAGE-LENGTH
           PERFORM 7360-VALIDATE-ROUNDING-CENT
           PERFORM 7370-VALIDATE-NORMAL-COMPLETION
           CONTINUE.
       7100-VALIDATE-ACCOUNT-KEY.
           IF WS-ACCOUNT = SPACES MOVE "ACCOUNT KEY REQUIRED" TO WS-MESSAGE END-IF.
       7110-VALIDATE-ACCOUNT-PREFIX.
           IF WS-ACCOUNT(1:3) NOT = "SYN" MOVE "SYNTHETIC KEY REQUIRED" TO WS-MESSAGE END-IF.
       7120-VALIDATE-ACCOUNT-STATUS.
           IF WS-STATUS = "BLOCKED" MOVE "ACCOUNT BLOCKED" TO WS-MESSAGE END-IF.
       7130-VALIDATE-BALANCE-SIGN.
           IF WS-BALANCE < ZERO MOVE "NEGATIVE BALANCE REVIEW" TO WS-MESSAGE END-IF.
       7140-VALIDATE-TRANSFER-AMOUNT.
           IF WS-AMOUNT <= ZERO MOVE "AMOUNT MUST BE POSITIVE" TO WS-MESSAGE END-IF.
       7150-VALIDATE-TRANSFER-CAP.
           IF WS-AMOUNT > 50000 MOVE "TRANSFER NEEDS REVIEW" TO WS-MESSAGE END-IF.
       7160-VALIDATE-TRANSFER-PAIR.
           IF WS-ACCOUNT = WS-SECOND-ACCOUNT MOVE "SOURCE AND TARGET MATCH" TO WS-MESSAGE END-IF.
       7170-VALIDATE-REQUEST-AID.
           IF WS-AID NOT = DFHENTER AND WS-AID NOT = DFHPF3 MOVE "UNSUPPORTED ATTENTION KEY" TO WS-MESSAGE END-IF.
       7180-VALIDATE-RETURN-STATE.
           IF WS-RESP NOT = DFHRESP(NORMAL) DISPLAY "CICS RESPONSE " WS-RESP END-IF.
       7190-VALIDATE-RESP2-STATE.
           IF WS-REAS NOT = ZERO DISPLAY "CICS RESP2 " WS-REAS END-IF.
       7200-VALIDATE-COMMAREA-SIZE.
           IF EIBCALEN > 128 MOVE "COMMAREA TOO LONG" TO WS-MESSAGE END-IF.
       7210-VALIDATE-COMMAREA-CONTENT.
           IF EIBCALEN > ZERO AND WS-ACCOUNT = LOW-VALUES MOVE "INVALID COMMAREA KEY" TO WS-MESSAGE END-IF.
       7220-VALIDATE-TRANSACTION-ID.
           IF EIBTRNID = SPACES DISPLAY "TRANSACTION ID NOT SET" END-IF.
       7230-VALIDATE-TERMINAL-ID.
           IF EIBTRMID = SPACES DISPLAY "TERMINAL ID NOT SET" END-IF.
       7240-VALIDATE-MAP-CURSOR.
           IF WS-AID = DFHENTER CONTINUE ELSE CONTINUE END-IF.
       7250-VALIDATE-STATUS-FIELD.
           IF WS-STATUS = SPACES MOVE "STATUS UNKNOWN" TO WS-MESSAGE END-IF.
       7260-VALIDATE-DUPLICATE-REQUEST.
           IF WS-ACCOUNT = WS-SECOND-ACCOUNT AND WS-ACCOUNT NOT = SPACES MOVE "DUPLICATE ACCOUNT PAIR" TO WS-MESSAGE END-IF.
       7270-VALIDATE-LOCK-RESPONSE.
           IF WS-RESP = DFHRESP(LOCKED) MOVE "RETRY RECORD LATER" TO WS-MESSAGE END-IF.
       7280-VALIDATE-MISSING-RECORD.
           IF WS-RESP = DFHRESP(NOTFND) MOVE "NO ACCOUNT FOUND" TO WS-MESSAGE END-IF.
       7290-VALIDATE-MAP-FAIL.
           IF WS-RESP = DFHRESP(MAPFAIL) MOVE "NO MAP DATA ENTERED" TO WS-MESSAGE END-IF.
       7300-VALIDATE-IO-RESPONSE.
           IF WS-RESP = DFHRESP(IOERR) MOVE "DATASET UNAVAILABLE" TO WS-MESSAGE END-IF.
       7310-VALIDATE-WRITE-RESPONSE.
           IF WS-RESP = DFHRESP(NORMAL) CONTINUE ELSE MOVE "WRITE NOT CONFIRMED" TO WS-MESSAGE END-IF.
       7320-VALIDATE-LINK-RESPONSE.
           IF WS-RESP = DFHRESP(NORMAL) CONTINUE ELSE MOVE "POSTING LINK FAILED" TO WS-MESSAGE END-IF.
       7330-VALIDATE-ROUTE-TARGET.
           IF WS-ACCOUNT(1:1) = SPACE MOVE "ROUTE KEY MISSING" TO WS-MESSAGE END-IF.
       7340-VALIDATE-BLOCK-IDEMPOTENCE.
           IF WS-STATUS = "BLOCKED" MOVE "BLOCK REQUEST IDEMPOTENT" TO WS-MESSAGE END-IF.
       7350-VALIDATE-MESSAGE-LENGTH.
           IF WS-MESSAGE(60:1) NOT = SPACE DISPLAY "MESSAGE TRUNCATION REVIEW" END-IF.
       7360-VALIDATE-ROUNDING-CENT.
           COMPUTE WS-AMOUNT ROUNDED = WS-AMOUNT ON SIZE ERROR MOVE 8 TO WS-RESP END-COMPUTE.
       7370-VALIDATE-NORMAL-COMPLETION.
           IF WS-RESP = DFHRESP(NORMAL) AND WS-MESSAGE = SPACES MOVE "REQUEST COMPLETE" TO WS-MESSAGE END-IF.

       7700-TRANSACTION-RESPONSE-CHECKS.
           PERFORM 7400-CHECK-PAGE-KEY
           PERFORM 7410-CHECK-REPEAT-READ
           PERFORM 7420-CHECK-UPDATE-CONTROL
           PERFORM 7430-CHECK-LOW-BALANCE
           PERFORM 7440-CHECK-CARD-CONTROL
           PERFORM 7450-CHECK-ACCOUNT-CLOSE
           PERFORM 7460-CHECK-MAP-INPUT-LENGTH
           PERFORM 7470-CHECK-MAP-ERROR-LENGTH
           PERFORM 7480-CHECK-REQUEST-AMOUNT
           PERFORM 7490-CHECK-TRANSFER-CURRENCY
           PERFORM 7500-CHECK-RESP-ABEND
           PERFORM 7510-CHECK-RESP2-ABEND
           PERFORM 7520-CHECK-QUEUE-RETRY
           PERFORM 7530-CHECK-PROTECTED-FIELD
           PERFORM 7540-CHECK-AID-CLEAR
           PERFORM 7550-CHECK-ATTENTION-KEY
           PERFORM 7560-CHECK-COMMAREA-RETURN
           PERFORM 7570-CHECK-ERROR-CONTEXT
           PERFORM 7580-CHECK-RECORD-VERSION
           PERFORM 7590-CHECK-RESPONSE-SAFETY
           PERFORM 7600-CHECK-LOCK-RELEASE
           PERFORM 7610-CHECK-ERROR-DISPOSITION
           PERFORM 7620-CHECK-RETURN-MESSAGE
           PERFORM 7630-CHECK-TRANSFER-POSTING
           PERFORM 7640-CHECK-BLOCK-POSTING
           PERFORM 7650-CHECK-API-BOUNDARY
           PERFORM 7660-CHECK-TRANSACTION-END
           CONTINUE.
       7400-CHECK-PAGE-KEY.
           IF WS-AID = DFHPF3 MOVE "RETURN TO MENU" TO WS-MESSAGE END-IF.
       7410-CHECK-REPEAT-READ.
           IF WS-ACCOUNT = SPACES AND WS-RESP = DFHRESP(NORMAL) MOVE "READ KEY LOST" TO WS-MESSAGE END-IF.
       7420-CHECK-UPDATE-CONTROL.
           IF WS-RESP = DFHRESP(NORMAL) CONTINUE ELSE DISPLAY "UPDATE CONTROL REQUIRED" END-IF.
       7430-CHECK-LOW-BALANCE.
           IF WS-BALANCE < ZERO MOVE "OVERDRAFT REVIEW" TO WS-MESSAGE END-IF.
       7440-CHECK-CARD-CONTROL.
           IF WS-STATUS = "BLOCKED" CONTINUE ELSE CONTINUE END-IF.
       7450-CHECK-ACCOUNT-CLOSE.
           IF WS-STATUS = "CLOSED" MOVE "ACCOUNT CLOSED" TO WS-MESSAGE END-IF.
       7460-CHECK-MAP-INPUT-LENGTH.
           IF ACCTIL > 12 MOVE "ACCOUNT FIELD TOO LONG" TO WS-MESSAGE END-IF.
       7470-CHECK-MAP-ERROR-LENGTH.
           IF MSGIL > 60 MOVE "MESSAGE FIELD TOO LONG" TO WS-MESSAGE END-IF.
       7480-CHECK-REQUEST-AMOUNT.
           IF WS-AMOUNT = ZERO MOVE "AMOUNT REQUIRED" TO WS-MESSAGE END-IF.
       7490-CHECK-TRANSFER-CURRENCY.
           IF WS-AMOUNT < ZERO MOVE "DEBIT AMOUNT EXPECTED" TO WS-MESSAGE END-IF.
       7500-CHECK-RESP-ABEND.
           IF WS-RESP NOT = DFHRESP(NORMAL) AND WS-RESP NOT = DFHRESP(NOTFND) DISPLAY "UNEXPECTED CICS RESP" END-IF.
       7510-CHECK-RESP2-ABEND.
           IF WS-REAS > ZERO DISPLAY "SECONDARY RESPONSE REVIEW" END-IF.
       7520-CHECK-QUEUE-RETRY.
           IF WS-REAS = 81 MOVE "RESOURCE BUSY RETRY" TO WS-MESSAGE END-IF.
       7530-CHECK-PROTECTED-FIELD.
           IF WS-ACCOUNT(1:3) = "SYN" CONTINUE ELSE MOVE "KEY PREFIX INVALID" TO WS-MESSAGE END-IF.
       7540-CHECK-AID-CLEAR.
           IF WS-AID = DFHCLEAR MOVE "INPUT CLEARED" TO WS-MESSAGE END-IF.
       7550-CHECK-ATTENTION-KEY.
           IF WS-AID = DFHENTER CONTINUE ELSE IF WS-AID = DFHPF3 CONTINUE END-IF END-IF.
       7560-CHECK-COMMAREA-RETURN.
           IF EIBCALEN = ZERO CONTINUE ELSE IF EIBCALEN < 32 MOVE "SHORT COMMAREA" TO WS-MESSAGE END-IF END-IF.
       7570-CHECK-ERROR-CONTEXT.
           IF WS-MESSAGE(1:5) = "ERROR" DISPLAY "CICS USER MESSAGE SET" END-IF.
       7580-CHECK-RECORD-VERSION.
           IF WS-COMMAREA = LOW-VALUES MOVE "RECORD VERSION INVALID" TO WS-MESSAGE END-IF.
       7590-CHECK-RESPONSE-SAFETY.
           IF WS-RESP = DFHRESP(INVREQ) MOVE "INVALID REQUEST REVIEW" TO WS-MESSAGE END-IF.
       7600-CHECK-LOCK-RELEASE.
           IF WS-RESP = DFHRESP(LOCKED) CONTINUE ELSE CONTINUE END-IF.
       7610-CHECK-ERROR-DISPOSITION.
           IF WS-RESP = DFHRESP(NORMAL) CONTINUE ELSE MOVE "REQUEST NOT COMMITTED" TO WS-MESSAGE END-IF.
       7620-CHECK-RETURN-MESSAGE.
           IF WS-MESSAGE = SPACES MOVE "RETURN TO TERMINAL" TO WS-MESSAGE END-IF.
       7630-CHECK-TRANSFER-POSTING.
           IF WS-AMOUNT > ZERO AND WS-RESP = DFHRESP(NORMAL) CONTINUE END-IF.
       7640-CHECK-BLOCK-POSTING.
           IF WS-STATUS = "BLOCKED" MOVE "BLOCK STATUS RETAINED" TO WS-MESSAGE END-IF.
       7650-CHECK-API-BOUNDARY.
           IF WS-RESP2 > 999999 MOVE "RESP2 RANGE REVIEW" TO WS-MESSAGE END-IF.
       7660-CHECK-TRANSACTION-END.
           IF EIBTRNID NOT = SPACES CONTINUE END-IF.
       7800-CHECK-TERM-TRANSACTION.
           IF EIBTRMID = SPACES DISPLAY "TERMINAL CONTEXT EMPTY" END-IF.
       7810-CHECK-USER-INPUT.
           IF WS-ACCOUNT = LOW-VALUES MOVE SPACES TO WS-ACCOUNT END-IF.
       7820-CHECK-RESPONSE-CODE.
           IF WS-RESP = DFHRESP(NORMAL) CONTINUE ELSE DISPLAY "RESP " WS-RESP END-IF.
       7830-CHECK-PROTECTED-STATUS.
           IF WS-STATUS = "BLOCKED" CONTINUE ELSE CONTINUE END-IF.
       7840-CHECK-RETURN-CONTEXT.
           IF WS-MESSAGE = SPACES MOVE "COMPLETED" TO WS-MESSAGE END-IF.
       7850-CHECK-BMS-INPUT-MAP.
           IF WS-RESP = DFHRESP(MAPFAIL)
               MOVE "MAP INPUT EMPTY" TO WS-MESSAGE
           END-IF.
       7860-CHECK-TASK-RESPONSE.
           IF WS-RESP = DFHRESP(NORMAL) DISPLAY "TASK RESPONSE NORMAL" END-IF.
       7870-CHECK-COMMAREA-RETURN-LENGTH.
           IF EIBCALEN > 128 MOVE "RETURN LENGTH REVIEW" TO WS-MESSAGE END-IF.
