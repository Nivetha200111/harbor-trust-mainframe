>>SOURCE FORMAT FREE
       IDENTIFICATION DIVISION.
       PROGRAM-ID. HTDATE.
      *> Shared callable service: Date normalization utility; no real customer data.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CALL-NAME PIC X(8) VALUE SPACES.
       01 WS-DATE-RAW PIC 9(6) VALUE ZERO.
       01 WS-DATE-FULL PIC 9(8) VALUE ZERO.
       01 WS-CENTURY PIC 99 VALUE 20.
       01 WS-TEMP PIC S9(11)V99 COMP-3 VALUE ZERO.
       01 WS-ROUND PIC S9(11)V99 COMP-3 VALUE ZERO.
       01 WS-COUNTER PIC 9(9) COMP-5 VALUE ZERO.
       01 WS-MESSAGE PIC X(80) VALUE SPACES.
       LINKAGE SECTION.
       01 LK-KEY PIC X(12).
       01 LK-AMOUNT PIC S9(9)V99 COMP-3.
       01 LK-RESULT.
          05 LK-ERROR PIC 9.
          05 LK-VALUE PIC S9(11)V99 COMP-3.
          05 LK-TEXT PIC X(80).
       PROCEDURE DIVISION USING LK-KEY
                                LK-AMOUNT
                                LK-RESULT.
       0000-MAIN.
           INITIALIZE LK-RESULT
           PERFORM 1000-VALIDATE-INTERFACE
           IF LK-ERROR = ZERO
               PERFORM 2000-PROCESS-REQUEST
           END-IF
           PERFORM 3900-SERVICE-CONTROLS
           PERFORM 5000-SERVICE-VALIDATIONS
           GOBACK.
       1000-VALIDATE-INTERFACE.
           IF LK-KEY = SPACES
               MOVE 4 TO LK-ERROR
           END-IF
           IF LK-AMOUNT < ZERO
               MOVE 8 TO LK-ERROR
           END-IF.
       2000-PROCESS-REQUEST.
           MOVE 991231 TO WS-DATE-RAW
           PERFORM 3000-DATE-WINDOW
           MOVE WS-DATE-FULL TO LK-VALUE.
       3000-DATE-WINDOW.
           IF WS-DATE-RAW(1:2) > 80
               MOVE 19 TO WS-CENTURY
           ELSE
               MOVE 20 TO WS-CENTURY
           END-IF
           MOVE WS-DATE-RAW TO WS-DATE-FULL(3:6)
           MOVE WS-CENTURY TO WS-DATE-FULL(1:2)
           MOVE WS-DATE-FULL TO LK-TEXT(1:8).
       3100-FEE-WAIVER.
           IF LK-KEY(12:1) = "Y"
               MOVE ZERO TO LK-VALUE
               MOVE "WAIVED: REDEFINES FLAG SET" TO LK-TEXT
           ELSE
               COMPUTE LK-VALUE = LK-AMOUNT * 0.035
                 ON SIZE ERROR MOVE 8 TO LK-ERROR
               END-COMPUTE
           END-IF.
       3200-FX-QUOTE.
           MOVE 1.0825 TO WS-TEMP
           COMPUTE LK-VALUE ROUNDED = LK-AMOUNT * WS-TEMP
             ON SIZE ERROR MOVE 8 TO LK-ERROR
           END-COMPUTE
           MOVE "RATE SCALE 4 DECIMAL PLACES" TO LK-TEXT.
       3300-DYNAMIC-CALL.
           MOVE "HTAUDT" TO WS-CALL-NAME
           CALL WS-CALL-NAME USING BY REFERENCE LK-KEY
             ON EXCEPTION MOVE 8 TO LK-ERROR
           END-CALL.
       3400-PACKED-POST.
           COMPUTE LK-VALUE ROUNDED = LK-AMOUNT
             ON SIZE ERROR MOVE 8 TO LK-ERROR
           END-COMPUTE
           IF WS-COUNTER = 999999999
               CALL "CEE3ABD" USING WS-COUNTER WS-COUNTER
                 ON EXCEPTION CONTINUE
               END-CALL
           END-IF.
       3500-AUDIT-FORMAT.
           MOVE LK-KEY TO LK-TEXT(1:12)
           MOVE LK-AMOUNT TO WS-ROUND
           MOVE WS-ROUND TO LK-VALUE.
       3900-SERVICE-CONTROLS.
           PERFORM 4100-CHECK-KEY-LOW-VALUES
           PERFORM 4110-CHECK-AMOUNT-CAP
           PERFORM 4120-CHECK-AMOUNT-FLOOR
           PERFORM 4130-CHECK-RESULT-STATE
           PERFORM 4140-CHECK-SERVICE-NAME
           PERFORM 4150-CHECK-DATE-CALENDAR
           PERFORM 4160-CHECK-DATE-DAY
           PERFORM 4170-CHECK-DATE-ROLLOVER
           PERFORM 4180-CHECK-WINDOW-LOW
           PERFORM 4190-CHECK-WINDOW-HIGH
           PERFORM 4200-CHECK-ROUND-BOUNDARY
           PERFORM 4210-CHECK-PACKED-DECIMAL
           PERFORM 4220-CHECK-RESULT-CONSISTENCY
           PERFORM 4230-CHECK-DYNAMIC-NAME
           PERFORM 4240-CHECK-KEY-CHARACTERS
           PERFORM 4250-CHECK-CALL-COUNTER
           PERFORM 4260-CHECK-AUDIT-LENGTH
           PERFORM 4270-CHECK-CURRENCY-SCALE
           PERFORM 4280-CHECK-WAIVER-STATE
           PERFORM 4290-CHECK-RATE-VALID
           PERFORM 4300-CHECK-RETURN-TEXT
           PERFORM 4310-CHECK-REFERENCE-KEY
           PERFORM 4320-CHECK-CONTENT-ISOLATION
           PERFORM 4330-CHECK-RESULT-INITIALIZED
           PERFORM 4340-CHECK-DECIMAL-ROUNDING
           PERFORM 4350-CHECK-CENTURY-POLICY
           PERFORM 4360-CHECK-RETURN-CODE
           CONTINUE.
       4100-CHECK-KEY-LOW-VALUES.
           IF LK-KEY = LOW-VALUES MOVE 4 TO LK-ERROR END-IF.
       4110-CHECK-AMOUNT-CAP.
           IF LK-AMOUNT > 999999999.99 MOVE 8 TO LK-ERROR END-IF.
       4120-CHECK-AMOUNT-FLOOR.
           IF LK-AMOUNT < -999999999.99 MOVE 8 TO LK-ERROR END-IF.
       4130-CHECK-RESULT-STATE.
           IF LK-ERROR = ZERO MOVE "OK" TO LK-TEXT(1:2) END-IF.
       4140-CHECK-SERVICE-NAME.
           IF WS-CALL-NAME = SPACES MOVE "SERVICE NAME UNSET" TO LK-TEXT END-IF.
       4150-CHECK-DATE-CALENDAR.
           IF WS-DATE-FULL(5:2) > 12 MOVE 8 TO LK-ERROR END-IF.
       4160-CHECK-DATE-DAY.
           IF WS-DATE-FULL(7:2) > 31 MOVE 8 TO LK-ERROR END-IF.
       4170-CHECK-DATE-ROLLOVER.
           IF WS-DATE-RAW = 123199 MOVE "YEAR END" TO LK-TEXT END-IF.
       4180-CHECK-WINDOW-LOW.
           IF WS-DATE-RAW(1:2) = 00 MOVE 20 TO WS-CENTURY END-IF.
       4190-CHECK-WINDOW-HIGH.
           IF WS-DATE-RAW(1:2) > 80 MOVE 19 TO WS-CENTURY END-IF.
       4200-CHECK-ROUND-BOUNDARY.
           COMPUTE WS-ROUND ROUNDED = LK-AMOUNT + 0.005 ON SIZE ERROR MOVE 8 TO LK-ERROR END-COMPUTE.
       4210-CHECK-PACKED-DECIMAL.
           COMPUTE WS-TEMP ROUNDED = LK-AMOUNT ON SIZE ERROR MOVE 8 TO LK-ERROR END-COMPUTE.
       4220-CHECK-RESULT-CONSISTENCY.
           IF LK-ERROR NOT = ZERO MOVE ZERO TO LK-VALUE END-IF.
       4230-CHECK-DYNAMIC-NAME.
           IF WS-CALL-NAME = "HTAUDT" CONTINUE ELSE MOVE 8 TO LK-ERROR END-IF.
       4240-CHECK-KEY-CHARACTERS.
           IF LK-KEY(1:3) NOT = "SYN" MOVE 4 TO LK-ERROR END-IF.
       4250-CHECK-CALL-COUNTER.
           ADD 1 TO WS-COUNTER ON SIZE ERROR MOVE 8 TO LK-ERROR END-ADD.
       4260-CHECK-AUDIT-LENGTH.
           IF LK-TEXT = SPACES MOVE "NO AUDIT DETAIL" TO LK-TEXT END-IF.
       4270-CHECK-CURRENCY-SCALE.
           IF WS-TEMP < ZERO MOVE 8 TO LK-ERROR END-IF.
       4280-CHECK-WAIVER-STATE.
           IF LK-KEY(12:1) = "Y" MOVE ZERO TO LK-VALUE END-IF.
       4290-CHECK-RATE-VALID.
           IF WS-TEMP > 999.9999 MOVE 8 TO LK-ERROR END-IF.
       4300-CHECK-RETURN-TEXT.
           IF LK-ERROR NOT = ZERO MOVE "CALL FAILED" TO LK-TEXT END-IF.
       4310-CHECK-REFERENCE-KEY.
           IF LK-KEY(12:1) = SPACE CONTINUE END-IF.
       4320-CHECK-CONTENT-ISOLATION.
           MOVE LK-AMOUNT TO WS-TEMP.
       4330-CHECK-RESULT-INITIALIZED.
           IF LK-RESULT = LOW-VALUES INITIALIZE LK-RESULT END-IF.
       4340-CHECK-DECIMAL-ROUNDING.
           IF LK-AMOUNT = 0.005 MOVE "HALF CENT" TO LK-TEXT END-IF.
       4350-CHECK-CENTURY-POLICY.
           IF WS-CENTURY < 19 OR WS-CENTURY > 20 MOVE 8 TO LK-ERROR END-IF.
       4360-CHECK-RETURN-CODE.
           IF LK-ERROR > 8 MOVE 8 TO LK-ERROR END-IF.
       5000-SERVICE-VALIDATIONS.
           PERFORM 5100-CHECK-CONTENT-KEY
           PERFORM 5110-CHECK-LOW-VALUES
           PERFORM 5120-CHECK-DECIMAL-UPPER
           PERFORM 5130-CHECK-DECIMAL-LOWER
           PERFORM 5140-CHECK-HALF-CENT
           PERFORM 5150-CHECK-ROUNDING
           PERFORM 5160-CHECK-RESULT-RESET
           PERFORM 5170-CHECK-RESULT-MESSAGE
           PERFORM 5180-CHECK-WINDOW-BEGIN
           PERFORM 5190-CHECK-WINDOW-END
           PERFORM 5200-CHECK-CALENDAR-MONTH
           PERFORM 5210-CHECK-CALENDAR-DAY
           PERFORM 5220-CHECK-RATE-FOUR-PLACES
           PERFORM 5230-CHECK-RATE-NONZERO
           PERFORM 5240-CHECK-FEE-WAIVER-STATE
           PERFORM 5250-CHECK-AUDIT-KEY
           PERFORM 5260-CHECK-CALL-COUNTER
           PERFORM 5270-CHECK-VALUE-SIGN
           PERFORM 5280-CHECK-DATE-ROLLOVER
           PERFORM 5290-CHECK-LEAP-DAY
           PERFORM 5300-CHECK-CONTENT-COPY
           PERFORM 5310-CHECK-REFERENCE-RETURN
           PERFORM 5320-CHECK-DYNAMIC-CALL-NAME
           PERFORM 5330-CHECK-RETURN-TEXT
           PERFORM 5410-CHECK-SERVICE-POSTCONDITION
           PERFORM 5420-CHECK-SERVICE-POSTCONDITION
           PERFORM 5430-CHECK-SERVICE-POSTCONDITION
           PERFORM 5440-CHECK-SERVICE-POSTCONDITION
           PERFORM 5450-CHECK-SERVICE-POSTCONDITION
           PERFORM 5460-CHECK-SERVICE-POSTCONDITION
           PERFORM 5470-CHECK-SERVICE-POSTCONDITION
           PERFORM 5480-CHECK-SERVICE-POSTCONDITION
           PERFORM 5490-CHECK-SERVICE-POSTCONDITION
           PERFORM 5500-CHECK-SERVICE-POSTCONDITION
           PERFORM 5510-CHECK-SERVICE-POSTCONDITION
           PERFORM 5520-CHECK-SERVICE-POSTCONDITION
           PERFORM 5530-CHECK-SERVICE-POSTCONDITION
           PERFORM 5540-CHECK-SERVICE-POSTCONDITION
           PERFORM 5550-CHECK-SERVICE-POSTCONDITION
           PERFORM 5560-CHECK-SERVICE-POSTCONDITION
           PERFORM 5570-CHECK-SERVICE-POSTCONDITION
           CONTINUE.
       5100-CHECK-CONTENT-KEY.
           IF LK-KEY(1:3) NOT = "SYN" MOVE 4 TO LK-ERROR END-IF.
       5110-CHECK-LOW-VALUES.
           IF LK-KEY = LOW-VALUES MOVE 4 TO LK-ERROR END-IF.
       5120-CHECK-DECIMAL-UPPER.
           IF LK-AMOUNT > 999999999.99 MOVE 8 TO LK-ERROR END-IF.
       5130-CHECK-DECIMAL-LOWER.
           IF LK-AMOUNT < -999999999.99 MOVE 8 TO LK-ERROR END-IF.
       5140-CHECK-HALF-CENT.
           IF LK-AMOUNT = 0.005 MOVE "HALF CENT ROUNDING" TO LK-TEXT END-IF.
       5150-CHECK-ROUNDING.
           COMPUTE WS-ROUND ROUNDED = LK-AMOUNT ON SIZE ERROR MOVE 8 TO LK-ERROR END-COMPUTE.
       5160-CHECK-RESULT-RESET.
           IF LK-ERROR NOT = ZERO MOVE ZERO TO LK-VALUE END-IF.
       5170-CHECK-RESULT-MESSAGE.
           IF LK-ERROR NOT = ZERO MOVE "SERVICE ERROR" TO LK-TEXT END-IF.
       5180-CHECK-WINDOW-BEGIN.
           IF WS-DATE-RAW(1:2) <= 80 MOVE 20 TO WS-CENTURY END-IF.
       5190-CHECK-WINDOW-END.
           IF WS-DATE-RAW(1:2) > 80 MOVE 19 TO WS-CENTURY END-IF.
       5200-CHECK-CALENDAR-MONTH.
           IF WS-DATE-FULL(5:2) > 12 MOVE 8 TO LK-ERROR END-IF.
       5210-CHECK-CALENDAR-DAY.
           IF WS-DATE-FULL(7:2) > 31 MOVE 8 TO LK-ERROR END-IF.
       5220-CHECK-RATE-FOUR-PLACES.
           MOVE 1.0825 TO WS-TEMP IF WS-TEMP NOT = 1.0825 MOVE 8 TO LK-ERROR END-IF.
       5230-CHECK-RATE-NONZERO.
           IF WS-TEMP = ZERO MOVE 8 TO LK-ERROR END-IF.
       5240-CHECK-FEE-WAIVER-STATE.
           IF LK-KEY(12:1) = "Y" MOVE ZERO TO LK-VALUE END-IF.
       5250-CHECK-AUDIT-KEY.
           IF LK-KEY = SPACES MOVE "AUDIT KEY MISSING" TO LK-TEXT END-IF.
       5260-CHECK-CALL-COUNTER.
           ADD 1 TO WS-COUNTER ON SIZE ERROR MOVE 8 TO LK-ERROR END-ADD.
       5270-CHECK-VALUE-SIGN.
           IF LK-VALUE < ZERO MOVE "NEGATIVE RESULT REVIEW" TO LK-TEXT END-IF.
       5280-CHECK-DATE-ROLLOVER.
           IF WS-DATE-RAW = 991231 MOVE "YEAR END ROLLOVER" TO LK-TEXT END-IF.
       5290-CHECK-LEAP-DAY.
           IF WS-DATE-FULL = 20240229 MOVE "LEAP DAY" TO LK-TEXT END-IF.
       5300-CHECK-CONTENT-COPY.
           MOVE LK-AMOUNT TO WS-TEMP.
       5310-CHECK-REFERENCE-RETURN.
           IF LK-ERROR > 8 MOVE 8 TO LK-ERROR END-IF.
       5320-CHECK-DYNAMIC-CALL-NAME.
           IF WS-CALL-NAME NOT = SPACES AND WS-CALL-NAME NOT = "HTAUDT" MOVE 8 TO LK-ERROR END-IF.
       5330-CHECK-RETURN-TEXT.
           IF LK-TEXT = SPACES AND LK-ERROR = ZERO MOVE "OK" TO LK-TEXT(1:2) END-IF.
       5410-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5420-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5430-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5440-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5450-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5460-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5470-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5480-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5490-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5500-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5510-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5520-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5530-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5540-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5550-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5560-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
       5570-CHECK-SERVICE-POSTCONDITION.
           IF LK-ERROR = ZERO
               IF LK-KEY(1:3) = "SYN" CONTINUE
               ELSE MOVE 4 TO LK-ERROR
               END-IF
           END-IF.
