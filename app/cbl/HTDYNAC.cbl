       IDENTIFICATION DIVISION.
       PROGRAM-ID. HTDYNAC.
      * Fictional Harbor Trust training specimen. Synthetic data only.
      * Dynamic CALL via program-name variable plus CEE3ABD abend.
      * IBM Enterprise COBOL batch program.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IN-FILE ASSIGN TO INPUT-FILE
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-IN-STATUS.
           SELECT OUT-FILE ASSIGN TO OUTPUT-FILE
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-OUT-STATUS.
           SELECT AUDIT-FILE ASSIGN TO AUDIT-FILE
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-AUDIT-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  IN-FILE.
       01  IN-RECORD PIC X(160).
       FD  OUT-FILE.
       01  OUT-RECORD PIC X(200).
       FD  AUDIT-FILE.
       01  AUDIT-RECORD PIC X(200).
       WORKING-STORAGE SECTION.
       01  WS-IN-STATUS PIC XX VALUE SPACES.
       01  WS-OUT-STATUS PIC XX VALUE SPACES.
       01  WS-AUDIT-STATUS PIC XX VALUE SPACES.
       01  WS-EOF PIC X VALUE "N".
           88 END-OF-INPUT VALUE "Y".
       01  WS-ERROR PIC X VALUE "N".
           88 INPUT-ERROR VALUE "Y".
       01  WS-RECORD-COUNT PIC 9(9) COMP-5 VALUE ZERO.
       01  WS-ACCEPT-COUNT PIC 9(9) COMP-5 VALUE ZERO.
       01  WS-REJECT-COUNT PIC 9(9) COMP-5 VALUE ZERO.
       01  WS-RETURN-COUNT PIC 9(7) COMP-5 VALUE ZERO.
       01  WS-EDGE-CODE PIC X(24) VALUE SPACES.
       01  WS-KEY PIC X(12) VALUE SPACES.
       01  WS-PREV-KEY PIC X(12) VALUE SPACES.
       01  WS-BRANCH PIC X(3) VALUE SPACES.
       01  WS-PREV-BRANCH PIC X(3) VALUE SPACES.
       01  WS-STATUS PIC X(8) VALUE SPACES.
       01  WS-AMOUNT PIC S9(9)V99 COMP-3 VALUE ZERO.
       01  WS-BALANCE PIC S9(9)V99 COMP-3 VALUE ZERO.
       01  WS-PRINCIPAL PIC S9(9)V99 COMP-3 VALUE ZERO.
       01  WS-RATE PIC 9V9999 COMP-3 VALUE ZERO.
       01  WS-INTEREST PIC S9(9)V99 COMP-3 VALUE ZERO.
       01  WS-FEE PIC 9(5)V99 COMP-3 VALUE ZERO.
       01  WS-FEE-WAIVED PIC X VALUE "N".
       01  WS-ENTRY-AMT PIC S9(9)V99 COMP-3 VALUE ZERO.
       01  WS-CYCLE-TOTAL PIC S9(11)V99 COMP-3 VALUE ZERO.
       01  WS-DEBITS PIC S9(11)V99 COMP-3 VALUE ZERO.
       01  WS-CREDITS PIC S9(11)V99 COMP-3 VALUE ZERO.
       01  WS-DELTA PIC S9(11)V99 COMP-3 VALUE ZERO.
       01  WS-OUT-OF-BALANCE PIC 9(7) COMP-5 VALUE ZERO.
       01  WS-DAYS-INACTIVE PIC 9(4) COMP-5 VALUE ZERO.
       01  WS-DAY-BASIS PIC 9(3) COMP-5 VALUE 365.
       01  WS-LEAP-FLAG PIC X VALUE "N".
           88 IS-LEAP-YEAR VALUE "Y".
       01  WS-AMOUNT-TEXT PIC X(12) VALUE SPACES.
       01  WS-SHORT-AMOUNT PIC X(6) VALUE SPACES.
       01  WS-OLD-DATE PIC 9(6) VALUE 991231.
       01  WS-CENTURY PIC 99 VALUE 20.
       01  WS-NEW-DATE PIC 9(8) VALUE ZERO.
       01  WS-LINE PIC X(200) VALUE SPACES.
       01  WS-REPORT-TOTAL PIC S9(11)V99 COMP-3 VALUE ZERO.
       01  WS-READ-TIME PIC 9(8) VALUE ZERO.
       01  WS-WRITE-TIME PIC 9(8) VALUE ZERO.
       01  WS-ABEND-CODE PIC S9(9) COMP-5 VALUE ZERO.
       01  WS-ITEM-COUNT PIC 9(2) COMP VALUE ZERO.
       01  WS-ITEMS OCCURS 1 TO 12 TIMES
           DEPENDING ON WS-ITEM-COUNT.
          05 WS-ITEM-CODE PIC X(4).
       01  WS-PACKED PIC S9(9)V99 COMP-3 VALUE ZERO.
       01  WS-ZONED PIC S9(7)V99 SIGN IS LEADING SEPARATE CHARACTER.
       01  WS-RAW-RECORD.
          05 WS-RAW-BASE PIC X(120).
          05 WS-FEE-OVERLAY REDEFINES WS-RAW-BASE.
             10 FILLER PIC X(119).
             10 WS-FEE-OVERRIDE PIC X.
       COPY HTDATE.
       COPY HTSTATUS.
       COPY HTERROR.
       01  WS-CALLED-PROGRAM PIC X(8) VALUE SPACES.
       01  WS-DYN-PARM.
          05 WS-DYN-DATE PIC 9(8) VALUE ZERO.
          05 WS-DYN-BASIS PIC 9(3) COMP-5 VALUE 365.
       01  WS-DYN-CHOICE PIC X VALUE "D".
           88 USE-DATE-UTILITY VALUE "D".
           88 USE-FALLBACK VALUE "F".
       01  WS-ABEND-FLAG PIC X VALUE "N".
           88 FORCE-ABEND VALUE "Y".
       01  WS-CEE-ABCODE PIC S9(9) COMP-5 VALUE 999.
       01  WS-CEE-TIMING PIC S9(9) COMP-5 VALUE ZERO.
       PROCEDURE DIVISION.
       0000-MAIN.
           PERFORM 1000-INITIALIZE
           PERFORM UNTIL END-OF-INPUT
               PERFORM 2000-READ-INPUT
               IF NOT END-OF-INPUT
                   PERFORM 3000-VALIDATE-RECORD
                   IF NOT INPUT-ERROR
                       PERFORM 4000-PROCESS-RECORD
                       PERFORM 5000-WRITE-RESULT
                   ELSE
                       PERFORM 6000-REJECT-RECORD
                   END-IF
               END-IF
           END-PERFORM
           PERFORM 7000-FINALIZE
           GOBACK.
       1000-INITIALIZE.
           OPEN INPUT IN-FILE
           IF WS-IN-STATUS NOT = "00"
               DISPLAY "OPEN INPUT FAILED " WS-IN-STATUS
               MOVE 12 TO RETURN-CODE
               SET END-OF-INPUT TO TRUE
           END-IF
           OPEN OUTPUT OUT-FILE
           IF WS-OUT-STATUS NOT = "00"
               DISPLAY "OPEN OUTPUT FAILED " WS-OUT-STATUS
               MOVE 12 TO RETURN-CODE
               SET END-OF-INPUT TO TRUE
           END-IF
           OPEN OUTPUT AUDIT-FILE
           IF WS-AUDIT-STATUS NOT = "00"
               DISPLAY "OPEN AUDIT FAILED " WS-AUDIT-STATUS
               MOVE 12 TO RETURN-CODE
               SET END-OF-INPUT TO TRUE
           END-IF
           MOVE ZERO TO WS-RECORD-COUNT WS-ACCEPT-COUNT
                        WS-REJECT-COUNT WS-RETURN-COUNT
           MOVE SPACES TO WS-EDGE-CODE
           PERFORM 1100-CHECK-RUN-CONTROL
           PERFORM 1200-INITIALIZE-TOTALS.
       1100-CHECK-RUN-CONTROL.
           IF WS-OLD-DATE(1:2) > 80
               MOVE 19 TO WS-CENTURY
           ELSE
               MOVE 20 TO WS-CENTURY
           END-IF
           MOVE WS-CENTURY TO WS-NEW-DATE(1:2)
           MOVE WS-OLD-DATE TO WS-NEW-DATE(3:6)
           IF WS-NEW-DATE = ZEROES
               MOVE "BAD-RUN-DATE" TO WS-EDGE-CODE
           END-IF
           MOVE WS-NEW-DATE TO WS-READ-TIME.
       1200-INITIALIZE-TOTALS.
           MOVE ZERO TO WS-REPORT-TOTAL WS-CYCLE-TOTAL
                        WS-DEBITS WS-CREDITS WS-DELTA
           MOVE ZERO TO WS-OUT-OF-BALANCE
           MOVE SPACES TO WS-PREV-KEY WS-PREV-BRANCH
           MOVE 365 TO WS-DAY-BASIS
           MOVE "N" TO WS-LEAP-FLAG WS-FEE-WAIVED.
       2000-READ-INPUT.
           READ IN-FILE
             AT END SET END-OF-INPUT TO TRUE
             NOT AT END
               ADD 1 TO WS-RECORD-COUNT
               MOVE IN-RECORD TO WS-RAW-BASE
               MOVE IN-RECORD(1:12) TO WS-KEY
               MOVE IN-RECORD(13:3) TO WS-BRANCH
               MOVE IN-RECORD(16:8) TO WS-AMOUNT-TEXT
               MOVE IN-RECORD(24:8) TO WS-SHORT-AMOUNT
               MOVE IN-RECORD(32:8) TO WS-STATUS
           END-READ
           IF WS-IN-STATUS NOT = "00"
              AND WS-IN-STATUS NOT = "10"
               DISPLAY "READ FAILURE " WS-IN-STATUS
               SET INPUT-ERROR TO TRUE
               SET END-OF-INPUT TO TRUE
           END-IF.
       3000-VALIDATE-RECORD.
           MOVE "N" TO WS-ERROR
           IF WS-KEY = SPACES PERFORM 3100-BAD-KEY END-IF
           IF WS-AMOUNT-TEXT IS NOT NUMERIC
               PERFORM 3200-BAD-AMOUNT
           END-IF
           IF WS-STATUS = SPACES PERFORM 3300-BAD-STATUS END-IF
           IF WS-BRANCH IS NOT ALPHABETIC
               PERFORM 3400-BAD-BRANCH
           END-IF
           IF WS-RECORD-COUNT > 1 AND WS-KEY < WS-PREV-KEY
               MOVE "SORT-ORDER" TO WS-EDGE-CODE
           END-IF
           MOVE WS-KEY TO WS-PREV-KEY
           PERFORM 3500-CHECK-MULTI-RECORD-TYPE
           PERFORM 3600-CHECK-DATE-BOUNDARY.
       3100-BAD-KEY.
           SET INPUT-ERROR TO TRUE
           MOVE "MISSING-KEY" TO WS-EDGE-CODE.
       3200-BAD-AMOUNT.
           SET INPUT-ERROR TO TRUE
           MOVE "INVALID-AMOUNT" TO WS-EDGE-CODE.
       3300-BAD-STATUS.
           SET INPUT-ERROR TO TRUE
           MOVE "INVALID-STATUS" TO WS-EDGE-CODE.
       3400-BAD-BRANCH.
           SET INPUT-ERROR TO TRUE
           MOVE "INVALID-BRANCH" TO WS-EDGE-CODE.
       3500-CHECK-MULTI-RECORD-TYPE.
           IF IN-RECORD(1:1) NOT = "A" AND NOT = "T"
               MOVE "UNKNOWN-RECORD-TYPE" TO WS-EDGE-CODE
           END-IF
           IF IN-RECORD(2:1) = "D"
               MOVE 2 TO WS-ITEM-COUNT
           ELSE
               MOVE 1 TO WS-ITEM-COUNT
           END-IF
           PERFORM VARYING WS-READ-TIME FROM 1 BY 1
               UNTIL WS-READ-TIME > WS-ITEM-COUNT
               MOVE "0000" TO WS-ITEM-CODE(WS-READ-TIME)
           END-PERFORM.
       3600-CHECK-DATE-BOUNDARY.
           IF WS-NEW-DATE = ZEROES
               SET INPUT-ERROR TO TRUE
               MOVE "MISSING-DYN-DATE" TO WS-EDGE-CODE
           END-IF.
       4000-PROCESS-RECORD.
           PERFORM 4100-RESOLVE-TARGET
           PERFORM 4200-DYNAMIC-CALL
           PERFORM 4300-CONDITIONAL-ABEND
           PERFORM 8000-CALL-DATE-UTILITY.
       4100-RESOLVE-TARGET.
           IF IN-RECORD(60:1) = "F"
               SET USE-FALLBACK TO TRUE
               MOVE "HTDATEUT" TO WS-CALLED-PROGRAM
           ELSE
               SET USE-DATE-UTILITY TO TRUE
               MOVE "HTDATEUT" TO WS-CALLED-PROGRAM
           END-IF
           MOVE WS-NEW-DATE TO WS-DYN-DATE
           MOVE WS-DAY-BASIS TO WS-DYN-BASIS.
       4200-DYNAMIC-CALL.
      * Dynamic CALL through a data-name variable: the target
      * program name is resolved at run time from WS-CALLED-PROGRAM.
           CALL WS-CALLED-PROGRAM USING BY REFERENCE WS-DYN-DATE
               BY CONTENT WS-DYN-BASIS
           END-CALL
           IF RETURN-CODE NOT = ZERO
               DISPLAY "DYNAMIC CALL RC=" RETURN-CODE
               MOVE "DYNCALL-FAIL" TO WS-EDGE-CODE
           END-IF.
       4300-CONDITIONAL-ABEND.
           IF IN-RECORD(61:1) = "9"
               SET FORCE-ABEND TO TRUE
           END-IF
           IF FORCE-ABEND
               PERFORM 4310-INVOKE-CEE3ABD
           END-IF.
       4310-INVOKE-CEE3ABD.
      * Language Environment abnormal termination service.
           CALL "CEE3ABD" USING WS-CEE-ABCODE WS-CEE-TIMING
           END-CALL
           MOVE "ABEND-ISSUED" TO WS-EDGE-CODE.
       5000-WRITE-RESULT.
           MOVE SPACES TO WS-LINE OUT-RECORD
           STRING WS-KEY DELIMITED BY SIZE
                  "|" DELIMITED BY SIZE
                  WS-BRANCH DELIMITED BY SIZE
                  "|" DELIMITED BY SIZE
                  WS-EDGE-CODE DELIMITED BY SIZE
               INTO OUT-RECORD
           END-STRING
           WRITE OUT-RECORD
           IF WS-OUT-STATUS NOT = "00"
               DISPLAY "WRITE FAILURE " WS-OUT-STATUS
               MOVE 12 TO RETURN-CODE
           ELSE
               ADD 1 TO WS-ACCEPT-COUNT
               ADD WS-ENTRY-AMT TO WS-CYCLE-TOTAL
           END-IF
           MOVE OUT-RECORD TO AUDIT-RECORD
           WRITE AUDIT-RECORD
           IF WS-AUDIT-STATUS NOT = "00"
               DISPLAY "AUDIT WRITE FAILURE " WS-AUDIT-STATUS
           END-IF.
       6000-REJECT-RECORD.
           ADD 1 TO WS-REJECT-COUNT
           MOVE SPACES TO WS-LINE OUT-RECORD
           STRING "REJECT:" DELIMITED BY SIZE
                  WS-KEY DELIMITED BY SIZE
                  "|" DELIMITED BY SIZE
                  WS-EDGE-CODE DELIMITED BY SIZE
               INTO OUT-RECORD
           END-STRING
           WRITE OUT-RECORD
           IF WS-OUT-STATUS NOT = "00"
               DISPLAY "REJECT WRITE FAILURE " WS-OUT-STATUS
           END-IF.
       7000-FINALIZE.
           PERFORM 7100-CLOSE-FILES
           PERFORM 7200-WRITE-TRAILER
           PERFORM 7300-REPORT-COUNTS
           IF WS-REJECT-COUNT > 0
               DISPLAY "REJECTS PRESENT: " WS-REJECT-COUNT
           END-IF
           MOVE ZERO TO RETURN-CODE.
       7100-CLOSE-FILES.
           CLOSE IN-FILE
           IF WS-IN-STATUS NOT = "00"
               DISPLAY "CLOSE INPUT ISSUE " WS-IN-STATUS
           END-IF
           CLOSE OUT-FILE
           IF WS-OUT-STATUS NOT = "00"
               DISPLAY "CLOSE OUTPUT ISSUE " WS-OUT-STATUS
           END-IF
           CLOSE AUDIT-FILE
           IF WS-AUDIT-STATUS NOT = "00"
               DISPLAY "CLOSE AUDIT ISSUE " WS-AUDIT-STATUS
           END-IF.
       7200-WRITE-TRAILER.
           MOVE SPACES TO OUT-RECORD WS-LINE
           STRING "TRAILER COUNT=" DELIMITED BY SIZE
                  WS-RECORD-COUNT DELIMITED BY SIZE
              INTO OUT-RECORD
           END-STRING
           MOVE WS-CYCLE-TOTAL TO WS-PACKED
           MOVE WS-PACKED TO WS-ZONED
           ADD WS-DEBITS TO WS-REPORT-TOTAL
           SUBTRACT WS-CREDITS FROM WS-REPORT-TOTAL
           COMPUTE WS-DELTA = WS-DEBITS - WS-CREDITS
               ON SIZE ERROR MOVE ZERO TO WS-DELTA
           END-COMPUTE.
       7300-REPORT-COUNTS.
           DISPLAY "READ: " WS-RECORD-COUNT
           DISPLAY "ACCEPTED: " WS-ACCEPT-COUNT
           DISPLAY "REJECTED: " WS-REJECT-COUNT
           DISPLAY "RETURNS: " WS-RETURN-COUNT
           DISPLAY "OUT-OF-BALANCE: " WS-OUT-OF-BALANCE.
       8000-CALL-DATE-UTILITY.
           CALL "HTDATEUT" USING BY REFERENCE WS-NEW-DATE
               BY CONTENT WS-DAY-BASIS
           END-CALL
           IF RETURN-CODE NOT = ZERO
               DISPLAY "DATE UTILITY RC=" RETURN-CODE
               MOVE "DATEUT-FAIL" TO WS-EDGE-CODE
           END-IF
           IF IS-LEAP-YEAR
               MOVE 366 TO WS-DAY-BASIS
           ELSE
               MOVE 365 TO WS-DAY-BASIS
           END-IF.
       9000-ABEND-HANDLER.
           DISPLAY "FATAL ERROR " WS-EDGE-CODE
           MOVE 16 TO RETURN-CODE
           GOBACK.
