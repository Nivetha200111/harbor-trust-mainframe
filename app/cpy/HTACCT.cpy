       01 :PFX:-ACCOUNT-RECORD.
          05 :PFX:-ACCOUNT-KEY PIC X(12).
          05 :PFX:-ALT-KEY PIC X(20).
          05 :PFX:-CUSTOMER-TOKEN PIC X(20).
          05 :PFX:-BALANCE PIC S9(9)V99 COMP-3.
          05 :PFX:-STATUS PIC X.
             88 :PFX:-OPEN VALUE "A".
             88 :PFX:-BLOCKED VALUE "B".
             88 :PFX:-DORMANT VALUE "D".
          05 :PFX:-VARIANT-AREA PIC X(6).
          05 :PFX:-SAVINGS REDEFINES :PFX:-VARIANT-AREA.
             10 :PFX:-INTEREST-RATE PIC 9V9999 COMP-3.
          05 :PFX:-CHECKING REDEFINES :PFX:-VARIANT-AREA.
             10 :PFX:-OVERDRAFT-LIMIT PIC S9(7)V99 COMP-3.
          05 :PFX:-PRODUCT-COUNT PIC 99.
          05 :PFX:-PRODUCTS OCCURS 1 TO 12 DEPENDING ON :PFX:-PRODUCT-COUNT.
             10 :PFX:-PRODUCT-CODE PIC X(4).
