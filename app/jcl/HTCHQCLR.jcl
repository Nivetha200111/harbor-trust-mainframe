//HTCHQCLR JOB (HT),'HARBOR HTCHQCLR',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//STEP1    EXEC PGM=HTCHQCLR
//STEPLIB  DD DSN=HT.LOADLIB,DISP=SHR
//INPUT-FILE DD DSN=HT.SYNTH.CHECKIN,DISP=SHR
//OUTPUT-FILE DD DSN=HT.OUT.CLEAROUT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//AUDIT-FILE DD DSN=HT.OUT.CLEARAUDT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
