//HTCTRLBR JOB (HT),'HARBOR HTCTRLBR',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//STEP1    EXEC PGM=HTCTRLBR
//STEPLIB  DD DSN=HT.LOADLIB,DISP=SHR
//INPUT-FILE DD DSN=HT.SYNTH.TRANIN,DISP=SHR
//OUTPUT-FILE DD DSN=HT.OUT.CTRLBROUT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//AUDIT-FILE DD DSN=HT.OUT.CTRLBRAUDT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
