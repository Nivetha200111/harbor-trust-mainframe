//HTDBTRAN JOB (HT),'HARBOR HTDBTRAN',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* DB2 batch: bind the DBRM then run via the DSN subcommand.
//* Requires a DB2 subsystem and BIND before execution; not a
//* standalone GnuCOBOL job.
//BIND     EXEC PGM=IKJEFT01
//STEPLIB  DD DSN=HT.LOADLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(HTDB)
  BIND PROGRAM(HTDBTRAN) OWNER(HT) QUALIFIER(HT) -
    ISOLATION(CS) VALIDATE(BIND)
  END
/*
//RUN      EXEC PGM=IKJEFT01,COND=(0,NE,BIND)
//STEPLIB  DD DSN=HT.LOADLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(HTDB)
  RUN PROGRAM(HTDBTRAN) PLAN(HTDBTRANPLN)
  END
/*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
