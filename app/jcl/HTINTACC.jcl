//HTINTACC JOB (HT),'HARBOR HTINTACC',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//STEP1    EXEC PGM=HTINTACC
//STEPLIB  DD DSN=HT.LOADLIB,DISP=SHR
//INPUT-FILE DD DSN=HT.SYNTH.ACCTIN,DISP=SHR
//OUTPUT-FILE DD DSN=HT.OUT.INTACCOUT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
