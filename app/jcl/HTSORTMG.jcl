//HTSORTMG JOB (HT),'HARBOR HTSORTMG',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* Pre-sort the synthetic transaction stream on the 12-byte key
//* before the COBOL SORT/MERGE step consumes it.
//SORTIN   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=HT.SYNTH.TRANIN,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(MOD,PASS),SPACE=(CYL,(2,1)),
//             DCB=(RECFM=FB,LRECL=160,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,12,CH,A)
/*
//STEP1    EXEC PGM=HTSORTMG
//STEPLIB  DD DSN=HT.LOADLIB,DISP=SHR
//INPUT-FILE DD DSN=&&SORTED,DISP=(OLD,DELETE)
//OUTPUT-FILE DD DSN=HT.OUT.MERGEOUT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//AUDIT-FILE DD DSN=HT.OUT.MERGEAUDT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1)),DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
