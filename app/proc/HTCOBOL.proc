//HTCOBOL PROC SRC=,LOAD=
//COB      EXEC PGM=IGYCRCTL,PARM='LIB,APOST,RENT,NUMPROC(PFD)'
//SYSLIB   DD DSN=HT.COPYLIB,DISP=SHR
//SYSIN    DD DSN=&SRC,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(MOD,PASS),SPACE=(CYL,(1,1))
//LKED     EXEC PGM=IEWL,COND=(4,LT,COB),PARM='LIST,RENT,AMODE(31),RMODE(ANY)'
//SYSLMOD  DD DSN=&LOAD,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//         PEND
